# Database URL — SQLite for local dev, PostgreSQL for production
# SQLite:     sqlite:///wiki_edits.db
# PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///wiki_edits.db

# Wikipedia EventStreams SSE endpoint
SSE_URL=https://stream.wikimedia.org/v2/stream/recentchange

# Lift Wing API (for vandalism silver labels)
LIFTWING_URL=https://api.wikimedia.org/service/lw/inference/v1/models/enwiki-damaging:predict

# Batch insert settings
BATCH_SIZE=50
BATCH_TIMEOUT_SECONDS=10

# DB cleanup: delete edits older than N days
RETENTION_DAYS=7
